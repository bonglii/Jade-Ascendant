; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="jade-ascendant"
run/main_scene="res://scenes/system/boot.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

DebugLogger="*res://scripts/debug/DebugLogger.gd"
Localizer="*res://scripts/managers/localization_manager.gd"
GameSession="*res://scripts/managers/GameSession.gd"
SaveManager="*res://scripts/managers/save_manager.gd"
ProgressionManager="*res://scripts/game/ProgressionManager.gd"
JourneyManager="*res://scripts/managers/journey_manager.gd"
AchievementManager="*res://scripts/managers/achievement_manager.gd"
DailyQuestManager="*res://scripts/managers/daily_quest_manager.gd"
EquipmentManager="*res://scripts/ui/equipment_manager.gd"
InventoryManager="*res://scripts/managers/inventory_manager.gd"
RewardManager="*res://scripts/managers/reward_manager.gd"
SceneTransitionManager="*res://scripts/managers/scene_transition_manager.gd"
SettingsManager="*res://scripts/managers/settings_manager.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"
CombatFeedback="*res://scripts/effects/combat_feedback.gd"
PavilionManager="*res://scripts/managers/pavilion_manager.gd"
MonetizationManager="*res://scripts/managers/monetization_manager.gd"

[display]

window/size/viewport_width=648
window/size/viewport_height=1152
window/size/window_width_override=405
window/size/window_height_override=860
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[global_group]

enemy=""
boss=""
elite=""
player=""

[gui]

common/default_scroll_deadzone=6

