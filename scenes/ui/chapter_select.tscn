[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/chapter_select.gd" id="1_chapter"]
[ext_resource type="Theme" path="res://assets/ui/jade_ui_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://scripts/ui/mobile_safe_area.gd" id="3_safe"]
[ext_resource type="Script" path="res://scripts/ui/wuxia_realm_backdrop.gd" id="4_backdrop"]
[ext_resource type="Script" path="res://scripts/ui/wuxia_plaque_button.gd" id="5_plaque"]

[node name="ChapterSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_chapter")

[node name="RealmBackdrop" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("4_backdrop")

[node name="ReadabilityShade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.003, 0.016, 0.027, 0.22)

[node name="TopAccent" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 3.0
grow_horizontal = 2
mouse_filter = 2
color = Color(0.957, 0.78, 0.357, 0.76)

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 18
script = ExtResource("3_safe")

[node name="MainLayout" type="VBoxContainer" parent="SafeArea"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TopBar" type="HBoxContainer" parent="SafeArea/MainLayout"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_override_constants/separation = 10

[node name="BackButton" type="Button" parent="SafeArea/MainLayout/TopBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(106, 44)
layout_mode = 2
theme_type_variation = &"JadeBackButton"
theme_override_colors/font_color = Color(1, 0.941, 0.737, 1)
theme_override_colors/font_hover_color = Color(1, 0.969, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "‹   BACK"
script = ExtResource("5_plaque")
plaque_style = 0

[node name="TopSpacer" type="Control" parent="SafeArea/MainLayout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="JourneyLabel" type="Label" parent="SafeArea/MainLayout/TopBar"]
layout_mode = 2
