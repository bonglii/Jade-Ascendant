theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 13

[node name="Header" type="VBoxContainer" parent="SafeArea/MainLayout/HeaderPanel/HeaderMargin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="EyebrowRow" type="HBoxContainer" parent="SafeArea/MainLayout/HeaderPanel/HeaderMargin/Header"]
layout_mode = 2
